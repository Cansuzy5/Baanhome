// Insert INSIDE match /databases/{database}/documents in the current deployed rules.
// This is an additive fragment, NOT a replacement for the existing rules file.
// Do not enable the UI until emulator ownership tests pass and deployed rules are checked.
match /privateChatBackups/{uid} {
  function owner() { return request.auth != null && request.auth.uid == uid; }
  function validBackup() {
    let d = request.resource.data;
    return d.keys().hasOnly(['version', 'payload', 'updatedAt', 'expiresAt'])
      && d.version is string && d.version.size() == 36
      && d.payload is string && d.payload.size() <= 180000
      && d.updatedAt == request.time
      && d.expiresAt is timestamp
      && d.expiresAt > request.time
      && d.expiresAt <= request.time + duration.value(31, 'd');
  }
  allow get, delete: if owner();
  allow list: if false;
  allow create, update: if owner() && validBackup();
}
